<html lang="nl">
    <head>
        <title>Top 2000 quiz</title>
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <style>
        .action-items {
            min-width: 125px;
            text-align: center;
            margin: 0 auto;
            width: 20%;
        }
        @media (width <= 768px) {
            .action-items {
                width: 50%;
            }
        }
        @media (width <= 992px) {
            .action-items {
                width: 40%;
            }
        }

        th {
            text-align: left;
        }
        #track-details {
            text-align: center;
            width: 70%;
            margin: 0 auto;
        }
        .inner-details {
            text-align: left;
            padding: 0.8rem 1rem;
            font-weight: bolder;
        }
        .hidden {
            display: none;
        }
        .action-item {
            width: 100%;
            margin-bottom: .8rem;
            padding: .3rem .2rem;
        }
        </style>
    </head>

    <body>
        <img src="/public/top2000_logo.png" alt="Top2000 logo" height="71" style="margin: 1rem auto; display: block">
        <h1 style="text-align: center; font-family: sans-serif">Raad het nummer</h1>
        <h4 style="text-align: center; font-family: sans-serif">Top 2000 (lijst 2023)</h4>
        <div class="action-items">
            <button class="action-item" id="play">&#9199; <span id="play-text">Spelen</span></button>
            <button class="action-item" disabled id="reveal">Toon nummer</button>
        </div>
        <div id="track-details" class="hidden">
            <table style="margin: 0 auto">
                <tr><th>Titel</th><td>{{ .track_name }}</td></tr>
                <tr><th>Artiest</th><td>{{ .artist_name }}</td></tr>
                <tr><th>Album</th><td>{{ .album_name }} &mdash; uitgebracht {{ .album_release_date }}</td></tr>
            </table>
            <div class="track-row"><a target="_blank" title="Open nummer in Spotify" href="https://open.spotify.com/track/{{ .track_id }}"><img height=250 width=250 src="{{ .album_image_url }}" alt="{{ .album_name }}"></a></div>

            <a href="/"><button style="margin-top: 1rem" class="action-item">Volgende nummer</button></a>
        </div>
        </div>
        <div id="embed-iframe"></div>
        <script src="https://open.spotify.com/embed/iframe-api/v1" async>
        </script>
        <script type="text/javascript">
            let playedOnce = false
            window.onSpotifyIframeApiReady = (IFrameAPI) => {
                const element = document.getElementById('embed-iframe');
                const options = {
                    width: '0%',
                    height: '0',
                    uri: {{ .track_uri }}
                };
                let playing = false
                const callback = (EmbedController) => {
                    let togglePlay = () => {
                        playing = !playing
                        if (!playing) {
                            EmbedController.pause()
                            document.getElementById("play-text").innerText = "Spelen"
                        } else {
                            // Playing
                            EmbedController.play()
                            document.getElementById("play-text").innerText = "Pauzeren"
                        }
                        if (!playedOnce) {
                            setTimeout(() => {
                                document.getElementById("reveal").removeAttribute("disabled")
                            }, 750)
                        }
                        playedOnce = true
                    }
                    document.getElementById("play").addEventListener("click", () => {
                        togglePlay()
                    })
                    document.addEventListener("keyup", e => {
                        if (e.key == " " ||
                            e.code == "Space" ||
                            e.keyCode == 32
                        ) {
                            togglePlay()
                        }
                    })
                };
                IFrameAPI.createController(element, options, callback);
            };

            document.getElementById("reveal").addEventListener("click", () => {
                document.getElementById("track-details").classList.remove("hidden")
            })
        </script>
    </body>
</html>
