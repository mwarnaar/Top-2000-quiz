<!DOCTYPE html>
<html lang="nl">
    <head>
        <title>Top 2000 quiz</title>
        <link rel="icon" href="public/favicon.svg" sizes="any" type="image/svg+xml">
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <style>
        .action-items {
            min-width: 125px;
            text-align: center;
            margin: 0 auto;
            width: 30%;
        }
        label {
            width: 4rem;
            display: inline-block;
            text-align: right;
            padding-right: .2rem;
        }
        @media (width <= 992px) {
            .action-items {
                width: 70%;
            }
        }

        th {
            text-align: left;
        }
        #track-details {
            text-align: center;
            width: 70%;
            margin: 0 auto;
            padding: 1rem;
            border: 3px solid;
        }
        #track-details.correct {
            border-color: green;
        }
        #track-details.incorrect {
            border-color: #b60000;
        }
        .inner-details {
            text-align: left;
            padding: 0.8rem 1rem;
            font-weight: bolder;
        }
        .hidden {
            display: none;
        }
        .action-item {
            width: 100%;
            margin-bottom: .8rem;
            padding: .3rem .2rem;
        }
        </style>
    </head>

    <body>
        <img src="/public/top2000_logo.png" alt="Top2000 logo" height="71" style="margin: 1rem auto; display: block">
        <h1 style="text-align: center; font-family: sans-serif">Raad het nummer</h1>
        <h4 style="text-align: center; font-family: sans-serif">Top 2000 (lijst 2025)</h4>
        <div class="action-items">
            <form onsubmit="return submitForm(event)">
                <button class="action-item" id="play" type="button">&#9199; <span id="play-text">Spelen</span></button>
                <div class="action-item">
                    <label for="artist-choice">Artiest:</label>
                    <input list="artists" id="artist-choice" name="artist-choice" />
                    <datalist id="artists">
                    </datalist>
                </div>
                <div class="action-item">
                    <label for="track-choice">Titel:</label>
                    <input list="tracks" id="track-choice" name="track-choice" />
                    <datalist id="tracks"></datalist>
                </div>
                <button type="submit" class="action-item" disabled="disabled" id="reveal">Check</button>
            </form>
        </div>
        <div id="track-details" class="hidden">
            <table style="margin: 0 auto">
                <tr><th>Artiest</th><td>{{ .Artist_name }}</td></tr>
                <tr><th>Titel</th><td>{{ .Track_name }}</td></tr>
                <tr><th>Album</th><td>{{ .Album_name }} &mdash; uitgebracht {{ .Album_release_date }}</td></tr>
            </table>
            <div class="track-row"><a target="_blank" title="Open nummer in Spotify" href="https://open.spotify.com/track/{{ .Track_id }}"><img height=250 width=250 src="{{ .Album_image_url }}" alt="{{ .Album_name }}"></a></div>

            <a href="/"><button style="margin-top: 1rem" class="action-item" id="next" type="button">Volgende nummer</button></a>
        </div>
        <div id="embed-iframe"></div>
        <script src="https://open.spotify.com/embed/iframe-api/v1" async>
        </script>
        <script src="/public/songs_tracks.js"></script>
        <script type="text/javascript">
            let playedOnce = false
            const populateArtistOptions = () => {
                const artistsDataList = document.getElementById("artists")
                const artistOptions = songs_tracks["artists"]
                const artistsFragment = document.createDocumentFragment()
                for (const artistOption of artistOptions) {
                    const artistDatalistOption = document.createElement("option")
                    artistDatalistOption.value = artistOption
                    artistDatalistOption.innerText = artistOption
                    artistsFragment.appendChild(artistDatalistOption)
                }
                artistsDataList.appendChild(artistsFragment)
            }
            const populateTrackOptions = () => {
                const tracksDataList = document.getElementById("tracks")
                const trackOptions = songs_tracks["track_names"]
                const tracksFragment = document.createDocumentFragment()
                for (const trackOption of trackOptions) {
                    const trackDatalistOption = document.createElement("option")
                    trackDatalistOption.value = trackOption
                    trackDatalistOption.innerText = trackOption
                    tracksFragment.appendChild(trackDatalistOption)
                }
                tracksDataList.appendChild(tracksFragment)
            }
            document.addEventListener("DOMContentLoaded", () => {
                populateArtistOptions()
                populateTrackOptions()
            })

            window.onSpotifyIframeApiReady = (IFrameAPI) => {
                const element = document.getElementById('embed-iframe')
                const options = {
                    width: '0%',
                    height: '0',
                    uri: "{{ .Track_href }}"
                }
                let playing = false
                const callback = (EmbedController) => {
                    let togglePlay = () => {
                        playing = !playing
                        if (!playing) {
                            EmbedController.pause()
                            document.getElementById("play-text").innerText = "Spelen"
                        } else {
                            // Playing
                            EmbedController.play()
                            document.getElementById("play-text").innerText = "Pauzeren"
                        }
                        if (!playedOnce) {
                            setTimeout(() => {
                                document.getElementById("reveal").removeAttribute("disabled")
                            }, 750)
                        }
                        playedOnce = true
                    }
                    document.getElementById("play").addEventListener("click", () => {
                        togglePlay()
                    })
                }
                IFrameAPI.createController(element, options, callback)
            }

            const submitForm = event => {
                event.preventDefault()
                reveal()
                return false
            }

            const reveal = () => {
                document.getElementById("track-details").classList.remove("hidden")
                const selectedArtist = document.getElementById("artist-choice").value
                const selectedTrack = document.getElementById("track-choice").value
                const correct = selectedTrack == "{{ .Track_name }}" && selectedArtist == "{{ .Artist_name }}"

                document.getElementById("track-details").classList.remove("correct")
                document.getElementById("track-details").classList.remove("incorrect")
                document.getElementById("track-details").classList.add(correct ? "correct": "incorrect")
            }
        </script>
    </body>
</html>
